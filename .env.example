# Bu dosyayı ".env" adıyla kopyalayın, kullanacağınız sağlayıcının
# anahtarını doldurun. ".env" dosyası .gitignore sayesinde repoya girmez.
#
# Kopyalamak için (Git Bash):
#   cp .env.example .env

# OpenAI (metin + görsel)
OPENAI_API_KEY=

# Anthropic (metin)
ANTHROPIC_API_KEY=

# Uygulama Giriş Şifresi (Login paneli için)
APP_PASSWORD=

# Oturum token imza anahtarı — Vercel'de ZORUNLU, rastgele üretin:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
